    {
        "id": "resp_history",
        "type": "function",
        "z": "flow_api",
        "name": "Build Response History",
        "func": "var rows = Array.isArray(msg.payload) ? msg.payload : [];\n\n// Query mengambil terbaru dulu; dibalik supaya urutannya lama -> baru\nvar data = rows.reverse().map(function (r) {\n    r.melewati_batas = r.melewati_batas === 1;\n    return r;\n});\n\nmsg.payload = {\n    status: 'success',\n    count: data.length,\n    data: data\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
