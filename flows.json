    {
        "id": "54e3a4ab1b0063b5",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Threshold",
        "func": "const raw = msg.payload && msg.payload.batas;\nconst batas = (raw === undefined || raw === null || raw === '') ? NaN : Number(raw);\n\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\n\nif (!isFinite(batas)) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'batas harus berupa angka' };\n    return msg;\n}\n\nflow.set('batas', batas);\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Batas suhu disimpan', batas: batas };\nreturn msg;",
