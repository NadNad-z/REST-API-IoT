        "type": "function",
        "z": "flow_api",
        "name": "Cek API Key",
        "func": "const API_KEY = 'iot-kampus-2026';\nconst key = msg.req.headers['x-api-key'];\n\nif (key !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'API key tidak valid' };\n    msg.headers = { 'Access-Control-Allow-Origin': '*' };\n    return [null, msg];   // keluar lewat output 2 (ditolak)\n}\nreturn [msg, null];       // keluar lewat output 1 (boleh masuk)",
