    {
        "id": "store_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\n\n// Bandingkan dengan batas suhu (default 30 kalau belum pernah diatur)\nvar batas = flow.get('batas');\nif (batas === undefined) batas = 30;\ndata.batas = batas;\ndata.melewati_batas = data.suhu > batas;\n\n// Notifikasi di sisi Node-RED (muncul di panel debug)\nif (data.melewati_batas) {\n    node.warn('PERINGATAN: suhu ' + data.suhu + ' °C melewati batas ' + batas + ' °C');\n}\n\n// Data terakhir tetap di flow context (cepat dibaca /api/suhu)\nflow.set('lastSensor', data);\n\n// History disimpan ke database SQLite (output 2)\nvar suhu = Number(data.suhu);\nvar hum = Number(data.kelembaban);\nif (!isFinite(suhu) || !isFinite(hum)) {\n    node.warn('Data sensor tidak valid, tidak disimpan ke database');\n    return [msg, null];\n}\nvar esc = function (s) { return String(s).replace(/'/g, \"''\"); };\nvar sql = \"INSERT INTO sensor (suhu, kelembaban, timestamp, received, batas, melewati_batas) VALUES (\" +\n    suhu + \", \" + hum + \", '\" + esc(data.timestamp) + \"', '\" + esc(data.received) + \"', \" +\n    Number(batas) + \", \" + (data.melewati_batas ? 1 : 0) + \")\";\n\nreturn [msg, { topic: sql }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 100,
        "wires": [
            [
                "debug_sensor",
                "fn_ws_format"
            ],
            [
                "db_insert"
            ]
        ]
    },
